# ─────────────────────────────────────────────────────────────
# SMC Gold Bot — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file and rename it to  .env
# 2. Fill in your values below
# 3. NEVER commit the real .env file to Git!
# ─────────────────────────────────────────────────────────────

# ── MetaApi Credentials ───────────────────────────────────────
# Sign up free at https://app.metaapi.cloud
# Then: Add Account → copy the Token and Account ID below
META_API_TOKEN=your_metaapi_token_here
META_API_ACCOUNT_ID=your_account_id_here

# ── Prop Firm MT4/MT5 Details (MetaApi will ask for these) ────
# You don't need to put them here — enter them in MetaApi dashboard
# when adding your account. This is just for reference.
# PROP_FIRM_LOGIN=12345678
# PROP_FIRM_PASSWORD=YourPassword
# PROP_FIRM_SERVER=YourBroker-Server

# ── Bot Settings (override main_bot.py defaults here) ─────────
ACCOUNT_BALANCE=10000
RISK_PERCENT=1.0
MIN_RR=2.0
MAX_OPEN_TRADES=2

# ── Supabase Integration ──────────────────────────────────────
# Find these in your Supabase Dashboard → Settings → API
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Safety ────────────────────────────────────────────────────
# Keep DRY_RUN=true until you are 100% happy with backtest results
DRY_RUN=false
